        "/api/categories": {
            "get": {
                "tags": [
                    "Categories"
                ],
                "summary": "Get Category List",
                "description": "Fetches a list of categories. If 'type' is set to 'Parent', only parent categories (parent_id = 0) will be returned. If 'parent_id' is provided, it fetches all child categories of the given parent.",
                "operationId": "3f5817a34833d0a1f4af4548dd3aeaba",
                "parameters": [
                    {
                        "name": "type",
                        "in": "query",
                        "description": "Filter categories by type. Options: 'All' (default), 'Parent'",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "All",
                            "enum": [
                                "All",
                                "Parent"
                            ]
                        }
                    },
                    {
                        "name": "parent_id",
                        "in": "query",
                        "description": "Fetch all child categories of a given parent_id",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    },
                    {
                        "name": "page",
                        "in": "query",
                        "description": "Page number for pagination. Starts from 1.",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "example": 1
                    },
                    {
                        "name": "length",
                        "in": "query",
                        "description": "Number of records per page.",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "example": 20
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Success",
                        "content": {
                            "application/json": {}
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/products": {
            "post": {
                "tags": [
                    "Products"
                ],
                "summary": "Create a new product",
                "description": "Creates a new product with the required details.",
                "operationId": "e8185e307706e2cd84bbcf5171e2f09d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "product_family",
                                    "sku",
                                    "website"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "Name of the product",
                                        "type": "string",
                                        "example": "Sample Product"
                                    },
                                    "product_family": {
                                        "description": "ID of the product family",
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "sku": {
                                        "description": "Stock Keeping Unit (SKU) of the product",
                                        "type": "string",
                                        "example": "PROD-123"
                                    },
                                    "websites": {
                                        "description": "Array of website IDs where the product is available",
                                        "type": "array",
                                        "items": {
                                            "type": "integer",
                                            "example": 1
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Success",
                        "content": {
                            "application/json": {}
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
